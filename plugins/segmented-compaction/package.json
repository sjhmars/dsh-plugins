{
  "name": "@sjhmars/segmented-compaction",
  "version": "0.1.3",
  "description": "Recover failed Harness compaction with ordered segmented summaries",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "typecheck": "node scripts/build.mjs --check",
    "build": "node scripts/build.mjs",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "prepare:dev": "node scripts/prepare-dev.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1",
    "@deepseek-ai/dsh-settings": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-compaction": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-token-meter": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-alpha.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.1-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "react": "^18.3.1",
    "typescript": "^6.0.3",
    "tsdown": "^0.22.2",
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/schemastery": "link:../../../deepseek-harness/vendor/schemastery",
    "@deepseek-ai/dsh-settings": "link:../../../deepseek-harness/packages/settings/settings",
    "@deepseek-ai/dsh-llm": "link:../../../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../../../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-compaction": "link:../../../deepseek-harness/packages/compaction/compaction",
    "@deepseek-ai/dsh-token-meter": "link:../../../deepseek-harness/packages/llm/token-meter",
    "@deepseek-ai/dsh-home-paths": "link:../../../deepseek-harness/packages/util/home-paths",
    "@deepseek-ai/dsh-client-locale": "link:../../../deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-settings": "link:../../../deepseek-harness/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "link:../../../deepseek-harness/packages/client/ui-plugin-manager",
    "@deepseek-ai/dsh-agent": "link:../../../deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-compaction-basic": "link:../../../deepseek-harness/packages/compaction/compaction-basic"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "compaction",
    "segmented-compaction",
    "context-window",
    "summarization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjhmars/dsh-plugins.git",
    "directory": "plugins/segmented-compaction"
  },
  "disclosure": {
    "cloud": true,
    "network": [
      "User-configured Harness summarization provider endpoints"
    ],
    "offlineMode": false,
    "apiKeys": [],
    "permissions": [
      "settings:segmented-compaction",
      "session:read-compaction-history",
      "llm:compaction",
      "file-system:compaction-journals"
    ],
    "jurisdiction": [],
    "retention": "Local request, response and summary journals under $DSH_HOME/segmented-compaction are retained until manually deleted. Remote retention and jurisdiction depend on the configured model provider."
  }
}
