{
  "name": "@sjhmars/plugin-install",
  "version": "0.5.0",
  "description": "Install npm bundles and plain plugin components in the current Harness profile",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown -c tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ../../tests/register-harness.mjs --experimental-strip-types --test tests/*.test.ts"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "disclosure": {
    "cloud": false,
    "network": [
      "registry.npmjs.org"
    ],
    "offlineMode": false,
    "apiKeys": [],
    "permissions": [
      "profile:plugins"
    ],
    "jurisdiction": [],
    "retention": "none"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjhmars/dsh-plugins.git",
    "directory": "plugins/plugin-install"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1",
    "@deepseek-ai/dsh-app-boot": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-alpha.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-plugin-manager": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.1-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/schemastery": "link:../../../deepseek-harness/vendor/schemastery",
    "@deepseek-ai/dsh-app-boot": "link:../../../deepseek-harness/packages/boot/app-boot",
    "@deepseek-ai/dsh-client-connection": "link:../../../deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-client-locale": "link:../../../deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-settings": "link:../../../deepseek-harness/packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "link:../../../deepseek-harness/packages/client/ui-plugin-manager",
    "@deepseek-ai/dsh-plugin-manager": "link:../../../deepseek-harness/packages/boot/plugin-manager",
    "@deepseek-ai/dsh-atomic-write": "link:../../../deepseek-harness/packages/util/atomic-write"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  }
}
