{
  "name": "@sjhmars/plugin-install",
  "version": "0.3.1",
  "description": "Install out-of-tree dsh plugins by npm package name from Settings",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown -c tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "disclosure": {
    "cloud": false,
    "network": ["registry.npmjs.org"],
    "offlineMode": false,
    "apiKeys": [],
    "permissions": ["profile:plugins"],
    "jurisdiction": [],
    "retention": "none"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjhmars/dsh-plugins.git",
    "directory": "plugins/plugin-install"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.5",
    "@deepseek-ai/schemastery": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-app-boot": ">=0.1.2-alpha.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5",
    "react": "^18.2.0"
  },
  "dependencies": {
    "pnpm": "^10.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
