{
  "name": "@sjhmars/pi-ai-thinking",
  "version": "0.1.1",
  "description": "Model configuration helper: automatically adds thinking-intensity (reasoning effort) presets off/low/high/max to custom llm-pi-ai models defined on the Harness settings page",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "pi-ai",
    "llm",
    "model-config",
    "model-configuration",
    "custom-models",
    "reasoning-effort",
    "thinking-intensity",
    "provider",
    "presets"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown -c tsdown.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --import ../../tests/register-harness.mjs --test tests/*.test.ts"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "disclosure": {
    "cloud": false,
    "network": [],
    "offlineMode": true,
    "apiKeys": [],
    "permissions": [
      "settings:llm-pi-ai"
    ],
    "jurisdiction": [],
    "retention": "settings"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjhmars/dsh-plugins.git",
    "directory": "plugins/pi-ai-thinking"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1",
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.1",
    "@deepseek-ai/dsh-settings": ">=0.2.1-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/schemastery": "link:../../../deepseek-harness/vendor/schemastery",
    "@deepseek-ai/dsh-llm": "link:../../../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-settings": "link:../../../deepseek-harness/packages/settings/settings"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
