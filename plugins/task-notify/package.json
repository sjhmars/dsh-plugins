{
  "name": "@sjhmars/task-notify",
  "version": "0.1.0",
  "description": "Desktop notification when an agent finishes a task or waits for approval or a question, on Web and Desktop",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
    "files": ["lib/index.js", "lib/invariant.js", "lib/icon.png", "lib/show-toast.ps1", "lib/show-approval-ui.ps1", "lib/toast-activate.vbs", "lib/types/**/*.d.ts", "cordis.patch.yml"],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown -c tsdown.config.ts && node scripts/copy-icon.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjhmars/dsh-plugins.git",
    "directory": "plugins/task-notify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.5",
    "@deepseek-ai/schemastery": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-user-questions": ">=0.1.0-rc.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
